rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    // Driver Onboarding Approvals
    match /driver_approvals/{approvalId} {
      // Anyone can submit onboarding application
      allow create: if request.resource.data.phone != null && request.resource.data.driverName != null;
      // Read & update restricted to authenticated admins or the applicant phone match
      allow read: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Users / Passengers Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Drivers / Captains Fleet Documents
    match /drivers/{driverId} {
      // Active drivers visible to riders on map
      allow read: if true;
      // Captain can update own online status and coordinates
      allow update: if (isAuthenticated() && request.auth.uid == driverId) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // Rides Bookings
    match /rides/{rideId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      // Passenger creates ride for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Updates allowed only for participants
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Trips History
    match /trips/{tripId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Vehicles
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ratings
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Default Fallback: Deny unauthenticated writes
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
