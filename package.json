{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx tests/backend.test.ts",
    "test:android": "tsx tests/android_integration.test.ts",
    "test:payment": "tsx tests/payment_gateway.test.ts",
    "test:electron": "tsx apps/admin-electron/tests/electron_security.test.ts",
    "test:whatsapp": "tsx tests/whatsapp_auth.test.ts",
    "test:berry": "tsx tests/whatsapp_berry.test.ts",
    "test:all": "npm run test && npm run test:android && npm run test:payment && npm run test:whatsapp && npm run test:berry && npm run test:electron",
    "build:electron": "esbuild apps/admin-electron/src/main/main.ts --bundle --platform=node --format=cjs --outfile=apps/admin-electron/dist/main.cjs --external:electron && esbuild apps/admin-electron/src/preload/preload.ts --bundle --platform=node --format=cjs --outfile=apps/admin-electron/dist/preload.cjs --external:electron",
    "passenger:dev": "vite --config vite.config.ts",
    "passenger:build": "vite build",
    "passenger:cap:sync": "cap sync android --config apps/passenger/capacitor.config.ts",
    "captain:dev": "vite --config vite.config.ts",
    "captain:build": "vite build",
    "captain:cap:sync": "cap sync android --config apps/captain/capacitor.config.ts",
    "admin:dev": "vite --config vite.config.ts",
    "admin:build": "vite build",
    "postinstall": "node -e \"const f='node_modules/vite-plugin-pwa/dist/index.js'; if (require('fs').existsSync(f)) { let c=require('fs').readFileSync(f,'utf8'); if (c.includes('createRequire(_dirname);')) { c=c.replace('createRequire(_dirname);', 'createRequire(_dirname || process.cwd());').replace('typeof __dirname !== \\\"undefined\\\" ?', 'typeof __dirname !== \\\"undefined\\\" && __dirname !== \\\".\\\" ?'); require('fs').writeFileSync(f, c); } }\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/preferences": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "berryprotocol": "^0.1.10",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
